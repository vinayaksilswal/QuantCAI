DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# PayPal Billing Integration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_PRO_PLAN_ID=P-xxxxxxxxxxxxxxxxxxxx
PAYPAL_ENTERPRISE_PLAN_ID=P-xxxxxxxxxxxxxxxxxxxx
PAYPAL_MODE=sandbox

# External APIs
GEMINI_API_KEY=...
RAPIDAPI_PROXY_SECRET=...

# Application Settings
FRONTEND_URL=https://quantcai.in
ENVIRONMENT=production
LOG_LEVEL=INFO

# WarriorPlus Integration (DEPRECATED — 90-day sunset, remove after migration)
WARRIORPLUS_SECURITY_KEY=your_warriorplus_security_key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://quantcai.in/login
