# ⚠️ Environment Variables Template ⚠️
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://your_user:your_password@localhost:5432/your_database"

# JWT Authentication Secrets
# Generate a secure secret key using: python -c "import secrets; print(secrets.token_hex(32))"
# This should be at least 32 bytes (64 hex characters)
AUTH_SECRET_KEY="your_secret_key_here_minimum_32_bytes"
AUTH_ALGORITHM="HS256"

# Token Expiration (in minutes)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_MINUTES=10080  # 7 days

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Google OAuth (Optional)
# Get credentials from: https://console.developers.google.com/
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
