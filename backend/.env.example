# ⚠️ Environment Variables Template ⚠️
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Database Configuration (SQLAlchemy 2.0 format)
# Format: postgresql+psycopg2://username:password@host:port/database
DATABASE_URL="postgresql+psycopg2://your_user:your_password@localhost:5432/your_database"

# Generate a strong secret key (minimum 32 bytes):
# python -c "import secrets; print(secrets.token_hex(32))"
# Example output: 2e4f3d2c1b0a9f8e7d6c5b4a39383736353433222110ffeeddccbbaa99887766
#
# 🔐 CRITICAL: Do NOT use the default placeholder! The app will refuse to start.
AUTH_SECRET_KEY="your_strong_secret_key_here_min_32_bytes"
AUTH_ALGORITHM="HS256"

# Token Expiration (in minutes)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_MINUTES=10080  # 7 days

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
# Production: Use HTTPS only. Development: You can include HTTP localhost.
ALLOWED_ORIGINS="https://quantcai.in,https://www.quantcai.in,https://quantcai.onrender.com"

# Google OAuth (Optional)
# Get credentials from: https://console.developers.google.com/
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Account Lockout Policy (security)
# Max failed login attempts before lockout
MAX_FAILED_ATTEMPTS=5
# Lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# Environment (optional): Set to "development" to enable Swagger UI and relaxed CORS
# ENV=production

