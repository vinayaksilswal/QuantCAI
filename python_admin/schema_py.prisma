datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Audience {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  source    String   @default("checkout")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingState {
  id            String   @id @default("singleton")
  lastSocialIdx Int      @default(0)
  lastEmailIdx  Int      @default(0)
  autoApprove   Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model SocialPost {
  id           String   @id @default(cuid())
  campaignId   String?
  campaign     SocialCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  platform     String   // FACEBOOK, INSTAGRAM, BOTH
  type         String   @default("AUTO") // AUTO or MANUAL
  caption      String   @db.Text
  mediaUrls    String[]
  scheduledAt  DateTime
  postedAt     DateTime?
  status       String   @default("DRAFT") // DRAFT, POSTED, FAILED
  errorLog     String?  @db.Text
  fbPostId     String?
  igPostId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailCampaign {
  id           String   @id @default(cuid())
  campaignId   String?
  campaign     SocialCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type         String   @default("AUTO") // AUTO or MANUAL
  subject      String
  bodyText     String   @db.Text
  bodyHtml     String   @db.Text
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String   @default("DRAFT") // DRAFT, SENT, FAILED
  errorLog     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model SocialCampaign {
  id           String   @id @default(cuid())
  baseCaption  String   @db.Text
  mediaUrl     String   
  mediaType    String   
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  socialPosts     SocialPost[]
  emailCampaigns  EmailCampaign[]
}

generator py {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}
